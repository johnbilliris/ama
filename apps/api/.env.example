API_HOST=0.0.0.0
API_PORT=8000
AMA_ENVIRONMENT=dev
AMA_ENABLE_PRODUCTION_AUTH=0
AMA_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
AMA_ENTRA_AUDIENCE=api://disaster-response-hub
ALLOWED_AZURE_REGIONS=Australia East,Australia Southeast

# 025-agent-spec-compliance: Management API auth (FR-021)
MANAGEMENT_API_KEY=<your-local-dev-api-key>

# 025-agent-spec-compliance: Cosmos DB (dead-letters, radius, named-locations)
COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/

# Compatibility aliases (optional) for older scripts:
# ENVIRONMENT=dev
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_AUDIENCE=api://disaster-response-hub
# COSMOS_DB_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
