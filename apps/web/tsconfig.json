{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@web-coverage/*": [
        "../../tests/e2e/web-coverage/*"
      ],
      "@playwright/test": [
        "./node_modules/@playwright/test"
      ],
      "@playwright/test/reporter": [
        "./node_modules/@playwright/test/reporter"
      ],
      "@axe-core/playwright": [
        "./node_modules/@axe-core/playwright"
      ],
      "ajv": [
        "./node_modules/ajv"
      ],
      "ajv-formats": [
        "./node_modules/ajv-formats"
      ]
    }
  },
  "include": [
    "src/**/*",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../tests/e2e/web-coverage/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/__tests__/**"
  ]
}
