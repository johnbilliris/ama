{
  "name": "@ama/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "vitest run tests/a11y",
    "test:web-coverage": "playwright test --project=web-coverage-chromium",
    "test:web-coverage:mobile": "playwright test --project=web-coverage-mobile",
    "test:web-coverage:axe": "playwright test --project=web-coverage-axe",
    "test:web-coverage:p1": "playwright test --project=web-coverage-chromium --grep @p1",
    "test:web-coverage:shard": "playwright test --project=web-coverage-chromium"
  },
  "dependencies": {
    "@ama/domain": "workspace:*",
    "@ama/ui": "workspace:*",
    "@azure/monitor-opentelemetry": "^1.20.0",
    "@azure/msal-browser": "^5.9.0",
    "@azure/msal-react": "^5.3.2",
    "idb": "^8.0.3",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@axe-core/react": "^4.10.2",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.13.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.11.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.1.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  }
}
