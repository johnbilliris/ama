AGENT_RUNTIME=local
DEFAULT_REASONING_MODEL=gpt-4.1
DEFAULT_SUMMARY_MODEL=gpt-4o-mini
EVENT_CHANNEL_PREFIX=disaster-response
# Spec 036 / ADR-20 hard cutover — Foundry is the canonical chat plane.
# AZURE_AI_PROJECT_DEPLOYMENTS is a CSV of ``modelId@version=deploymentName``
# (e.g. ``gpt-5.4@2025-08-07=gpt-5.4-ama,gpt-5.4-mini@2025-08-07=gpt-5.4-mini-ama``).
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_PROJECT_DEPLOYMENTS=
AZURE_AI_PROJECT_REGION=australiaeast

# 025-agent-spec-compliance: Content Safety (F08)
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-content-safety>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=<your-key-for-local-dev-only>

# 025-agent-spec-compliance: Embedding similarity (F09)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# 025-agent-spec-compliance: IoT Hub adapter (F01)
IOT_HUB_CONNECTION_STRING=HostName=<hub>.azure-devices.net;SharedAccessKeyName=<name>;SharedAccessKey=<key>
IOT_HUB_EVENT_GRID_ENDPOINT=https://<your-container-app>.australiaeast.azurecontainerapps.io/api/v1/iot/telemetry

# 025-agent-spec-compliance: Dead-letter redelivery (FR-003a)
COSMOS_DB_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
DEAD_LETTER_POLL_INTERVAL_SECONDS=30
