## ─── azd environment ───
AZURE_ENV_NAME=drh-dev
AZURE_LOCATION=australiaeast

## ─── Provisioned outputs (set by azd provision via Bicep outputs) ───
COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=disaster-hub
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_REDIS_HOST=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_APP_INSIGHTS_CONNECTION_STRING=
AZURE_CONTAINER_REGISTRY_ENDPOINT=
AZURE_CONTAINER_REGISTRY_NAME=
AMA_ENTRA_TENANT_ID=
AMA_ENTRA_AUDIENCE=
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_TENANT_ID=
NEXT_PUBLIC_AZURE_AD_API_APP_ID=
NEXT_PUBLIC_AZURE_AD_API_AUDIENCE=
NEXT_PUBLIC_ALLOW_ANONYMOUS_INCIDENT_MAP=0
NEXT_PUBLIC_ALLOW_ANONYMOUS_DEV_ACCESS=1
AZURE_MAPS_SUBSCRIPTION_KEY=

## ─── Service endpoints (set by azd deploy) ───
SERVICE_API_ENDPOINT_URL=
SERVICE_WEB_ENDPOINT_URL=
API_ENDPOINT=

## ─── Local development overrides ───
AMA_ENVIRONMENT=dev
AMA_ENABLE_PRODUCTION_AUTH=0
AMA_ENABLE_INCIDENT_MAP_AUTH=0
AMA_ALLOW_ANONYMOUS_INCIDENT_MAP=0
AMA_ALLOW_ANONYMOUS_DEV_ACCESS=1
COSMOS_DATABASE_NAME=disaster-hub
REDIS_HOST=localhost
INGESTION_MAX_RECORDS_PER_CYCLE=100

# Deprecated aliases (accepted, but canonical keys above must be preferred):
# AZURE_COSMOS_ENDPOINT=
