{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example.org/specs/038/contracts/seed_record.schema.json",
  "title": "AMA Seed Catalogue File Envelope and Record (Spec 039, FR-010..FR-016, CL-5)",
  "description": "Static reference data files under packages/domain/src/domain/seed/**/*.json MUST validate against #/$defs/SeedFile. Every record persisted by scripts/seed_loader.py MUST validate against #/$defs/SeedRecord (record-level fictitious marker per CL-5). NDJSON variants use #/$defs/SeedNdjsonHeader + #/$defs/SeedRecord.",
  "oneOf": [
    { "$ref": "#/$defs/SeedFile" },
    { "$ref": "#/$defs/SeedNdjsonHeader" },
    { "$ref": "#/$defs/SeedRecord" }
  ],
  "$defs": {
    "FixtureWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fictitious", "residency", "licence", "schema_version"],
      "properties": {
        "fictitious":     { "const": true },
        "residency":      { "const": "AU" },
        "licence":        { "type": "string", "minLength": 1, "maxLength": 128 },
        "schema_version": { "type": "string", "pattern": "^\\d+$" }
      }
    },
    "SeedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_fixture", "records"],
      "properties": {
        "_fixture": { "$ref": "#/$defs/FixtureWrapper" },
        "records":  { "type": "array", "items": { "$ref": "#/$defs/SeedRecord" } }
      }
    },
    "SeedNdjsonHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_fixture_header", "fictitious", "residency", "licence", "schema_version"],
      "properties": {
        "_fixture_header": { "const": true },
        "fictitious":      { "const": true },
        "residency":       { "const": "AU" },
        "licence":         { "type": "string", "minLength": 1, "maxLength": 128 },
        "schema_version":  { "type": "string", "pattern": "^\\d+$" }
      }
    },
    "SeedRecord": {
      "type": "object",
      "required": ["id", "fictitious", "residency"],
      "properties": {
        "id":          { "type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]{1,127}$" },
        "fictitious":  { "const": true },
        "residency":   { "const": "AU" },
        "pspf":        { "enum": ["OFFICIAL", "OFFICIAL: SENSITIVE"] },
        "licence":     { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": true
    }
  }
}
