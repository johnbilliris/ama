{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example.org/specs/038/contracts/simulator_feed.schema.json",
  "title": "AMA Simulator Feed NDJSON Record Envelope (Spec 039, FR-021..FR-027)",
  "description": "Every line of fixtures/sim_replays/*.ndjson and every message published via apps/api/app/services/simulation/event_hub_publisher.py from a simulator feed module MUST validate against this schema. The first line of each NDJSON file is the _fixture_header (CL-5), separately defined.",
  "oneOf": [
    { "$ref": "#/$defs/FixtureHeader" },
    { "$ref": "#/$defs/SimulatorRecord" }
  ],
  "$defs": {
    "FixtureHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["_fixture_header", "fictitious", "residency", "licence", "scenario_id", "seed"],
      "properties": {
        "_fixture_header": { "const": true },
        "fictitious": { "const": true },
        "residency":  { "const": "AU" },
        "licence":    { "type": "string", "minLength": 1, "maxLength": 128 },
        "scenario_id":{ "type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]{1,127}$" },
        "seed":       { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "SimulatorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulated", "fictitious", "residency",
        "scenario_id", "seed", "source_shape",
        "timestamp", "feed_version", "correlation_id", "body"
      ],
      "properties": {
        "simulated":      { "const": true },
        "fictitious":     { "const": true },
        "residency":      { "const": "AU" },
        "scenario_id":    { "type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]{1,127}$" },
        "seed":           { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "source_shape":   { "type": "string", "pattern": "^[a-z0-9_.-]+\\.v\\d+$" },
        "timestamp":      { "type": "string", "format": "date-time", "description": "ISO-8601 UTC, microsecond precision; from SimulatedClock — NEVER wall-clock." },
        "feed_version":   { "type": "string", "pattern": "^v\\d+$" },
        "correlation_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "body":           { "type": "object", "description": "Feed-shape-specific payload; canonical-JSON-encodable." }
      },
      "allOf": [
        {
          "title": "Warning-shaped feeds MUST embed 'TEST — DO NOT BROADCAST' (FR-046). Pattern aligned to source_shapes.json registry (T017): bom.severe_weather_warning, bom.cyclone_track, ga.tsunami_threat. fire_weather_fdi and flood_gauge are index/sensor updates, not warnings.",
          "if": {
            "properties": {
              "source_shape": {
                "type": "string",
                "pattern": "^(bom\\.(severe_weather_warning|cyclone_track)|ga\\.tsunami_threat)\\.v\\d+$"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "type": "object",
                "required": ["test_marker"],
                "properties": {
                  "test_marker": { "const": "TEST — DO NOT BROADCAST" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
