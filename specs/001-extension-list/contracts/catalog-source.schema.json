{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ama:specify:contracts:catalog-source",
  "title": "AMA Spec Kit extension catalog source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extensions"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "extensions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/extension"
      }
    }
  },
  "$defs": {
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "integer",
          "minimum": 0
        },
        "templates": {
          "type": "integer",
          "minimum": 0
        },
        "scripts": {
          "type": "integer",
          "minimum": 0
        },
        "hooks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "install_allowed"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "description": {
          "type": ["string", "null"]
        },
        "author": {
          "type": ["string", "null"]
        },
        "install_allowed": {
          "type": "boolean"
        },
        "provides": {
          "$ref": "#/$defs/provides"
        }
      }
    }
  }
}
