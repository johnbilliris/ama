{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/johnbilliris/ama/specs/031-simplify-cicd-pipeline/contracts/azure-credentials.schema.json",
  "title": "AZURE_CREDENTIALS",
  "description": "Schema for the AZURE_CREDENTIALS GitHub Actions secret that authenticates each workflow against Azure for one of the dev/staging/production environments. The shape matches the output of `az ad sp create-for-rbac --sdk-auth`, which is the canonical input to the `azure/login@v3` action's `creds:` input.",
  "type": "object",
  "required": [
    "clientId",
    "clientSecret",
    "subscriptionId",
    "tenantId"
  ],
  "additionalProperties": false,
  "properties": {
    "clientId": {
      "type": "string",
      "format": "uuid",
      "description": "Service-principal application (client) ID. Must match the SP created for the target environment."
    },
    "clientSecret": {
      "type": "string",
      "minLength": 1,
      "description": "The service-principal client secret. Long-lived; manual rotation cadence of 90 days per ADR-031."
    },
    "subscriptionId": {
      "type": "string",
      "format": "uuid",
      "description": "Azure subscription containing the rg-drh-<env> resource group."
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "description": "Microsoft Entra tenant in which the service principal exists."
    },
    "activeDirectoryEndpointUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "default": "https://login.microsoftonline.com"
    },
    "resourceManagerEndpointUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "default": "https://management.azure.com/"
    },
    "activeDirectoryGraphResourceId": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "default": "https://graph.windows.net/"
    },
    "sqlManagementEndpointUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "galleryEndpointUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "managementEndpointUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  },
  "examples": [
    {
      "clientId": "00000000-0000-0000-0000-000000000000",
      "clientSecret": "REDACTED",
      "subscriptionId": "c8703ebc-bc5d-488d-9489-5883c9fde6c2",
      "tenantId": "b5e5570f-671d-4290-9a28-52c53214f03d",
      "activeDirectoryEndpointUrl": "https://login.microsoftonline.com",
      "resourceManagerEndpointUrl": "https://management.azure.com/",
      "activeDirectoryGraphResourceId": "https://graph.windows.net/",
      "sqlManagementEndpointUrl": "https://management.core.windows.net:8443/",
      "galleryEndpointUrl": "https://gallery.azure.com/",
      "managementEndpointUrl": "https://management.core.windows.net/"
    }
  ]
}
