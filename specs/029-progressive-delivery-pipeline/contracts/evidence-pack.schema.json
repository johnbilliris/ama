{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama/specs/029/contracts/evidence-pack.schema.json",
  "title": "Evidence Pack manifest",
  "description": "Manifest written into every evidence pack ZIP (FR-013). Pack contents are listed in 'contents_inventory'; each referenced file MUST be present in the ZIP.",
  "type": "object",
  "required": [
    "pack_digest",
    "storage_uri",
    "originating_artefact_digest",
    "target_environment",
    "outcome",
    "deploying_actor",
    "approver_identities",
    "contents_inventory",
    "linked_spec_ids",
    "retention_class",
    "created_at",
    "audit_event_id"
  ],
  "properties": {
    "pack_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "storage_uri": { "type": "string", "format": "uri" },
    "originating_artefact_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "target_environment": { "type": "string", "enum": ["dev", "staging", "production"] },
    "outcome": { "type": "string", "enum": ["success", "rollback", "freeze_pause"] },
    "deploying_actor": { "type": "string" },
    "approver_identities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Empty for non-emergency promotions; exactly 2 distinct identities for emergency-hotfix (FR-011a)."
    },
    "contents_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filename", "sha256", "size"],
        "properties": {
          "filename": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "kind": {
            "type": "string",
            "enum": [
              "test_results", "sbom", "image_signature", "vuln_scan",
              "bicep_what_if", "accessibility_report", "iac_policy_decisions",
              "posture_verifier_output", "burn_rate_window", "deploying_actor_record",
              "approval_log", "linked_spec_ids"
            ]
          }
        }
      }
    },
    "linked_spec_ids": { "type": "array", "items": { "type": "string" } },
    "retention_class": { "type": "string", "enum": ["seven_years_legal_hold"] },
    "created_at": { "type": "string", "format": "date-time" },
    "audit_event_id": { "type": "string" }
  },
  "additionalProperties": false
}
