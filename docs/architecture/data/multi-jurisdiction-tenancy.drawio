<mxfile host="app.diagrams.net" modified="2026-09-15T00:00:00.000Z" agent="remediation-source-updated; export=pending-drawio" version="24.0.0">
  <diagram name="SECTOR-01" id="sector01-tenancy">
    <mxGraphModel><root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="2" value="FR-015 / Cosmos DB `signals` container hierarchical partition key (infra/main.bicep): /scope then /jurisdictionId then /dataSourceId (MultiHash v2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="1">
        <mxGeometry x="180" y="20" width="700" height="50" as="geometry"/>
      </mxCell>
      <mxCell id="50" value="Level 1 — /scope : tenant/environment scope resolved by TenantMiddleware (live or simulation scope). Scope is NOT a jurisdiction and NOT an agency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1">
        <mxGeometry x="180" y="80" width="700" height="45" as="geometry"/>
      </mxCell>
      <mxCell id="51" value="Level 2 — /jurisdictionId : read-filter predicate applied by SignalRepository (nine values below). Level 3 — /dataSourceId : feed identity (for example bom-warnings)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;" vertex="1" parent="1">
        <mxGeometry x="180" y="130" width="700" height="45" as="geometry"/>
      </mxCell>
      <mxCell id="3" value="/jurisdictionId = NSW&#xa;Hazard-dependent lead authority (illustrative): NSW RFS for bushfire; NSW SES for flood and storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="20" y="195" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="4" value="/jurisdictionId = VIC&#xa;Hazard-dependent lead authority (illustrative): CFA/FRV for bushfire; VICSES for flood and storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="300" y="195" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="5" value="/jurisdictionId = QLD&#xa;Hazard-dependent lead authority (illustrative): QFD for bushfire; QLD SES for flood and storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="580" y="195" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="6" value="/jurisdictionId = SA&#xa;Hazard-dependent lead authority (illustrative): SA CFS for bushfire; SA SES for flood and storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="20" y="295" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="7" value="/jurisdictionId = WA&#xa;Hazard-dependent lead authority (illustrative): DFES for bushfire, flood and storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="300" y="295" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="8" value="/jurisdictionId = TAS&#xa;Hazard-dependent lead authority (illustrative): TFS for bushfire; SES Tasmania for flood and storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="580" y="295" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="9" value="/jurisdictionId = ACT&#xa;Hazard-dependent lead authority (illustrative): ACT RFS for bushfire; ACT SES for flood and storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="20" y="395" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="10" value="/jurisdictionId = NT&#xa;Hazard-dependent lead authority (illustrative): NTFRS for bushfire; NTES for flood and storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="300" y="395" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="11" value="/jurisdictionId = CTH&#xa;Commonwealth coordination authority: NEMA (support and coordination, not state incident control)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#1f2937;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="580" y="395" width="250" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="12" value="Three distinct concepts: SCOPE is partition level 1 plus TenantMiddleware live/simulation isolation; JURISDICTION is partition level 2 plus the SignalRepository read filter; AUTHORITY is application-level lead-agency routing derived from jurisdiction + hazard + optional agency hint and is NOT a storage boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
        <mxGeometry x="20" y="505" width="810" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="13" value="Legacy note: the per-tenant key survives only on the separate sim-chat container; it is not the signals tenancy model and no jurisdiction is a separate physical tenant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#9ca3af;fontSize=11;dashed=1;" vertex="1" parent="1">
        <mxGeometry x="20" y="610" width="810" height="40" as="geometry"/>
      </mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
