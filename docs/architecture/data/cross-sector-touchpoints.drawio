      <mxCell id="22" value="AUTHORITY BOUNDARY: the lead agency for a crossing is hazard-dependent, not fixed per jurisdiction. Bushfire crossings are led by the fire sector; flood and storm crossings are led by the SES sector. A hazard outside both sets escalates to the state control agency named in the jurisdiction plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
        <mxGeometry x="60" y="770" width="1280" height="60" as="geometry"/>
      </mxCell>
