        <mxCell id="title" value="C4 L3 — Ingest container (apps/ingestion). Shows the successful persistence path through to the consuming agents, not only the dead-letter branch." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
