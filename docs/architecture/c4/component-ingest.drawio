        <mxCell id="note" value="Persistence is conditional: the pipeline writes signals only when a SignalRepository has been injected by the worker. Success is evidenced by persisted records and consumed messages, not by non-negative poll or deduplication counters." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
