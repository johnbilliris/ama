<mxfile host="app.diagrams.net" modified="2026-09-15T00:00:00.000Z" agent="remediation-source-updated; export=pending-drawio" version="24.0.0">
  <diagram name="C4-L3-Web" id="c4-l3-web">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 L3 — Web container (apps/web, Next.js on Azure App Service). Shows the full request and response round trip to the API container." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="Operator browser&#xa;Entra ID / OAuth 2.0 interactive sign-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sw" value="Offline service worker&#xa;queues actions when navigator.onLine is false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="shell" value="App shell and SovereigntyBanner&#xa;layout, navigation, persona switcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="90" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="panels" value="Workspace panels&#xa;alert feed, situation view, ic-approval-card, outcome monitor, audit receipt list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="210" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="apiclient" value="API client module&#xa;attaches the Entra bearer token to every call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="340" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API container (apps/api)&#xa;see C4 L3 API for the middleware order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="340" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="agents" value="Agents Runtime container&#xa;five canonical agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="340" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="entra" value="Microsoft Entra ID" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1">
          <mxGeometry x="98" y="220" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="appsvc" value="Azure App Service&#xa;web hosting" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1">
          <mxGeometry x="330" y="220" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="appins" value="Application Insights&#xa;browser telemetry" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/devops/Application_Insights.svg;" vertex="1" parent="1">
          <mxGeometry x="1250" y="180" width="64" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Round trip: browser action -> panel handler -> API client (bearer token) -> API middleware chain -> route handler -> service -> agent invocation -> response back through the API middleware -> API client -> panel re-render with a status message announced to assistive technology. When offline, the service worker queues the action and replays it through /api/offline/replay on reconnect." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="1390" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="sign-in redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="browser" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="page request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="browser" target="sw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="online passthrough" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="sw" target="shell"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="shell" target="panels"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="operator action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="panels" target="apiclient"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="HTTPS + bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="apiclient" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="invoke agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="agents"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="recommendation result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="agents" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="HTTP response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="api" target="apiclient"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="re-render + status message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="apiclient" target="panels"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="hosted on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="shell" target="appsvc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="shell" target="appins"><mxGeometry relative="1" as="geometry"/></mxCell>
