<mxfile host="app.diagrams.net" modified="2026-09-15T00:00:00.000Z" agent="remediation-source-updated; export=pending-drawio" version="24.0.0">
  <diagram name="SEQ-03" id="seq03-fallback">
    <mxGraphModel dx="1214" dy="686" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SEQ-03 — Canonical five-stage evacuation lifecycle. Authority: constitution and packages/domain/src/domain/models/evacuation_stage.py VALID_TRANSITIONS." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="prep" value="Preparation&#xa;PRECONDITION — outside the five-stage lifecycle. Planning, pre-positioning and community readiness occur before any Decision and are not a lifecycle stage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1. Decision&#xa;Decision authority, rationale, evacuation type (pre_warned or immediate), approach and scope recorded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="gate1" value="Human approval gate — warning publication authorisation (FR-009). Distinct from movement authorisation." style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b30000;strokeWidth=2;fontColor=#b30000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="65" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2. Warning&#xa;Warning alerts issued; evacuation timeframe published." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="gate2" value="Human approval gate — movement (withdrawal) authorisation. A rejected movement authorisation does NOT advance the lifecycle." style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b30000;strokeWidth=2;fontColor=#b30000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1000" y="65" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3. Withdrawal&#xa;Population movement tracked against the evacuation route network." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4. Shelter&#xa;Evacuation centres and assisted accommodation managed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="280" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5. Return&#xa;Return only after safety certification; phased return supported." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="280" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="Completed&#xa;terminal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="300" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sip" value="Shelter-in-place&#xa;ALTERNATIVE to withdrawal, entered directly from Decision when movement is more dangerous than remaining." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="470" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="reentry" value="Re-entry to Decision&#xa;Warning, Withdrawal, Shelter and Shelter-in-place can each return to Decision when conditions change; every re-entry increments the re-entry counter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="470" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Stage names are exactly Decision, Warning, Withdrawal, Shelter and Return. Preparation is a precondition, not a substitute for Decision. Immediate evacuation compresses the Decision-to-Warning interval but does not skip a stage; skipping stages is not a valid transition." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="1190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="readiness feeds the decision" style="endArrow=block;html=1;rounded=0;strokeWidth=2;dashed=1;" edge="1" parent="1" source="prep" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="authorise warning" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s1" target="gate1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="approved" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="gate1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="authorise movement" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s2" target="gate2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="approved" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="gate2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="withdrawal complete" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="area certified safe" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="return complete" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="s5" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="shelter-in-place instead of withdrawal" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="sip"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="re-enter Decision" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sip" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="conditions changed" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s4" target="reentry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="re-enter Decision" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="reentry" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
