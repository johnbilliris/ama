        <mxCell id="24" value="Decision path and outcome path are audited separately: the decision record (approve or reject) is written by the approval gate; the outcome record is written only when actuation runs. Channel adapters return in-process envelopes; external delivery acknowledgement is UNVERIFIED." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="1180" height="70" as="geometry"/></mxCell>
