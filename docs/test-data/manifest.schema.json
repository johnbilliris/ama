{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example.org/specs/038/contracts/manifest.schema.json",
  "title": "AMA Test-Data Manifest (Spec 038)",
  "description": "Canonical machine-readable manifest at docs/test-data/manifest.json. Validated by tools/lint/check_test_data_manifest.py in the existing `quality` job of .github/workflows/ci.yml (CL-7). Source-of-truth Pydantic models live in specs/038-test-data-provisioning/data-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ManifestEntry" }
    }
  },
  "$defs": {
    "KebabId":   { "type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]{1,127}$" },
    "Sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Semver":    { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "FeedVersion": { "type": "string", "pattern": "^v\\d+$" },
    "SourceShape": { "type": "string", "pattern": "^[a-z0-9_.-]+\\.v\\d+$" },
    "PosixPath": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
    "PspfMarking": { "enum": ["OFFICIAL", "OFFICIAL: SENSITIVE"] },
    "Category": {
      "enum": ["synthetic", "public", "generator", "mock",
                "simulator-feed-shape", "alert-template", "persona-binding"]
    },
    "DomainGroup": {
      "enum": ["operational", "fire", "police", "ambulance", "ses",
                "marine-aviation", "commonwealth", "cross-sector"]
    },
    "RefreshPolicy": {
      "enum": ["static", "refresh-on-public-dataset-update", "regenerate-each-run"]
    },
    "VolumeTier": { "enum": ["small", "medium", "large", "xlarge", "n/a"] },

    "ManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "category", "version", "content_hash", "created_or_updated",
        "persona_bindings", "domain_group",
        "fictitious", "pii", "pspf", "residency", "licence",
        "source_url", "snapshot_date", "dataset_version",
        "refresh_policy", "volume_tier", "record_count",
        "cultural_review_required"
      ],
      "properties": {
        "id":   { "$ref": "#/$defs/KebabId" },
        "name": { "type": "string", "minLength": 3, "maxLength": 160 },
        "category": { "$ref": "#/$defs/Category" },
        "path": { "$ref": "#/$defs/PosixPath" },
        "source_shape": { "$ref": "#/$defs/SourceShape" },
        "feed_version": { "$ref": "#/$defs/FeedVersion" },
        "version": { "$ref": "#/$defs/Semver" },
        "content_hash": { "$ref": "#/$defs/Sha256Hex" },
        "created_or_updated": { "type": "string", "format": "date" },
        "persona_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/KebabId" }
        },
        "domain_group": { "$ref": "#/$defs/DomainGroup" },
        "fictitious": { "const": true },
        "pii": { "const": false },
        "pspf": { "$ref": "#/$defs/PspfMarking" },
        "pspf_justification": { "type": "string", "minLength": 20 },
        "residency": { "const": "AU" },
        "licence": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_url": {
          "anyOf": [{ "type": "string", "format": "uri" }, { "const": "n/a" }]
        },
        "snapshot_date": {
          "anyOf": [{ "type": "string", "format": "date" }, { "const": "n/a" }]
        },
        "dataset_version": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 64 }, { "const": "n/a" }]
        },
        "refresh_policy": { "$ref": "#/$defs/RefreshPolicy" },
        "volume_tier": { "$ref": "#/$defs/VolumeTier" },
        "record_count": { "type": "integer", "minimum": 0 },
        "cultural_review_required": { "type": "boolean", "default": false },
        "cultural_review_notes": { "type": "string", "maxLength": 1024 }
      },

      "allOf": [
        {
          "title": "Public datasets must carry full provenance.",
          "if":   { "properties": { "category": { "const": "public" } } },
          "then": {
            "properties": {
              "source_url":      { "not": { "const": "n/a" } },
              "snapshot_date":   { "not": { "const": "n/a" } },
              "dataset_version": { "not": { "const": "n/a" } }
            }
          }
        },
        {
          "title": "Simulator feed shapes have source_shape + feed_version, no path.",
          "if":   { "properties": { "category": { "const": "simulator-feed-shape" } } },
          "then": {
            "required": ["source_shape", "feed_version"],
            "not": { "required": ["path"] }
          },
          "else": { "required": ["path"] }
        },
        {
          "title": "OFFICIAL: SENSITIVE requires written justification.",
          "if":   { "properties": { "pspf": { "const": "OFFICIAL: SENSITIVE" } } },
          "then": { "required": ["pspf_justification"] }
        },
        {
          "title": "Generators regenerate each run.",
          "if":   { "properties": { "category": { "const": "generator" } } },
          "then": { "properties": { "refresh_policy": { "const": "regenerate-each-run" } } }
        },
        {
          "title": "xlarge volume is generator-produced; never committed.",
          "if":   { "properties": { "volume_tier": { "const": "xlarge" } } },
          "then": { "properties": { "record_count": { "const": 0 } } }
        }
      ]
    }
  }
}
