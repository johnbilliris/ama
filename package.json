{
  "name": "ama-disaster-response-hub",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "lint:web": "corepack pnpm --filter @ama/web lint",
    "test:e2e": "corepack pnpm --filter @ama/web test:e2e",
    "test:help": "echo \"spec-038 help suite\" && pytest tests/contract/help tests/integration/help tests/unit/help -q --tb=line && corepack pnpm --filter @ama/web test -- --run help"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.5",
      "@eslint/plugin-kit": ">=0.7.1",
      "protobufjs": ">=8.0.2",
      "@protobufjs/utf8": ">=1.1.1",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "fast-uri": ">=3.1.2",
      "vite": ">=6.4.2",
      "esbuild": ">=0.25.0",
      "postcss": ">=8.5.10"
    }
  }
}