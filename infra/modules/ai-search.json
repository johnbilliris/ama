  "parameters": {
    "name": {
      "type": "string",
      "metadata": {
        "description": "AI Search service name"
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Location"
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "standard",
      "allowedValues": [
        "basic",
        "standard"
      ],
      "metadata": {
        "description": "SKU — Standard for prod, Basic for dev/staging"
      }
    },
    "replicaCount": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Replica count"
      }
    },
    "partitionCount": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Partition count"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags"
      }
    },
    "privateEndpointSubnetId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Subnet resource ID for Private Endpoint"
      }
    },
    "privateDnsZoneId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Private DNS zone resource ID for privatelink.search.windows.net"
      }
    },
    "disablePublicNetworkAccess": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Disable public network access (must be true in production)"
      }
    },
    "vectorDimensions": {
      "type": "int",
      "defaultValue": 3072,
      "minValue": 256,
      "maxValue": 3072,
      "metadata": {
        "description": "Embedding vector dimension (R-02 — text-embedding-3-large = 3072)"
      }
    },
    "jurisdictionValues": {
      "type": "array",
      "defaultValue": [
        "act",
        "nsw",
        "nt",
        "qld",
        "sa",
        "tas",
        "vic",
        "wa",
        "national",
        "aidr"
      ],
      "metadata": {
        "description": "Allowed jurisdiction filter values for the corpus index (FR-RAG-IDX-08)"
      }
    },
    "licenceModeValues": {
      "type": "array",
      "defaultValue": [
        "full-text",
        "metadata-only"
      ],
      "metadata": {
        "description": "Allowed licence_mode index filter values (FR-RAG-IDX-02). Excluded never reaches the index."
      }
    },
    "capacityAlertThresholdPercent": {
      "type": "int",
      "defaultValue": 70,
      "minValue": 50,
      "maxValue": 95,
      "metadata": {
        "description": "AI Search storage utilisation threshold (percent) at which the capacity alert fires (R-10; default 70)"
      }
    },
    "capacityActionGroupId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Action Group resource id for the capacity alert (defaults to empty = no notification action)"
      }
    },
    "enableCapacityAlert": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether to deploy the spec-036 capacity alert (FR-RAG-IDX-08 / R-10). Defaults to true; flip off for dev/staging."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Search/searchServices",
      "apiVersion": "2024-06-01-preview",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]"
      },
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "replicaCount": "[parameters('replicaCount')]",
        "partitionCount": "[parameters('partitionCount')]",
        "hostingMode": "default",
        "publicNetworkAccess": "[if(parameters('disablePublicNetworkAccess'), 'disabled', 'enabled')]",
        "networkRuleSet": {
          "ipRules": [],
          "bypass": "AzurePortal"
        },
        "semanticSearch": "standard",
        "disableLocalAuth": true
      }
    },
    {
      "condition": "[not(empty(parameters('privateEndpointSubnetId')))]",
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-pe', parameters('name'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "subnet": {
          "id": "[parameters('privateEndpointSubnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "[format('{0}-plsc', parameters('name'))]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Search/searchServices', parameters('name'))]",
              "groupIds": [
                "searchService"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', parameters('name'))]"
      ]
    },
    {
      "condition": "[and(not(empty(parameters('privateEndpointSubnetId'))), not(empty(parameters('privateDnsZoneId'))))]",
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/{1}', format('{0}-pe', parameters('name')), 'default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "privatelink-search-windows-net",
            "properties": {
              "privateDnsZoneId": "[parameters('privateDnsZoneId')]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-pe', parameters('name')))]"
      ]
    },
    {
      "condition": "[parameters('enableCapacityAlert')]",
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[take(format('alert-search-capacity-{0}', parameters('name')), 260)]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "[format('Spec 036 FR-RAG-IDX-08: AI Search storage utilisation crossed {0}% — schedule scale-out before R-10 fires.', parameters('capacityAlertThresholdPercent'))]",
        "severity": 2,
        "scopes": [
          "[resourceId('Microsoft.Search/searchServices', parameters('name'))]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "name": "StorageUtilisation",
              "metricName": "SearchLatency",
              "metricNamespace": "Microsoft.Search/searchServices",
              "operator": "GreaterThan",
              "threshold": "[parameters('capacityAlertThresholdPercent')]",
              "timeAggregation": "Average",
              "criterionType": "StaticThresholdCriterion"
            }
          ]
        },
        "enabled": true,
        "autoMitigate": true,
        "actions": "[if(empty(parameters('capacityActionGroupId')), createArray(), createArray(createObject('actionGroupId', parameters('capacityActionGroupId'))))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Search/searchServices', parameters('name'))]"
      ]
    }
  ],
  "outputs": {
    "searchServiceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Search/searchServices', parameters('name'))]"
    },
    "searchServiceName": {
      "type": "string",
      "value": "[parameters('name')]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Search/searchServices', parameters('name')), '2024-06-01-preview', 'full').identity.principalId]"
    },
    "vectorDimensions": {
      "type": "int",
      "value": "[parameters('vectorDimensions')]"
    },
    "jurisdictionValues": {
      "type": "array",
      "value": "[parameters('jurisdictionValues')]"
    },
    "licenceModeValues": {
      "type": "array",
      "value": "[parameters('licenceModeValues')]"
    },
    "capacityAlertThresholdPercent": {
      "type": "int",
      "value": "[parameters('capacityAlertThresholdPercent')]"
    }
  }
}