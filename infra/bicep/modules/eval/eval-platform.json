    "blobContainerNames": [
      "datasets",
      "runs",
      "audit-archive"
    ],
    "foundryAccountName": "[take(format('aoai-amaeval-{0}-{1}', variables('storageEnvSegment'), variables('shortUniqueSuffix')), 32)]",
    "foundryInferenceEndpoint": "[format('https://{0}.services.ai.azure.com/models', variables('foundryAccountName'))]",
    "foundryModelDeployments": [
      {
        "name": "gpt-5-6-sol",
        "modelName": "gpt-5.6-sol",
        "modelVersion": "2026-07-09",
        "format": "OpenAI",
        "sku": "GlobalStandard",
        "capacity": 10
      },
      {
        "name": "gpt-5-6-luna",
        "modelName": "gpt-5.6-luna",
        "modelVersion": "2026-07-09",
        "format": "OpenAI",
        "sku": "GlobalStandard",
        "capacity": 10
      },
      {
        "name": "phi-4",
        "modelName": "Phi-4",
        "modelVersion": "7",
        "format": "Microsoft",
        "sku": "GlobalStandard",
        "capacity": 1
      },
      {
        "name": "llama-3-3-70b-instruct",
        "modelName": "Llama-3.3-70B-Instruct",
        "modelVersion": "9",
        "format": "Meta",
        "sku": "GlobalStandard",
        "capacity": 1
      },
      {
        "name": "mistral-large-3",
        "modelName": "Mistral-Large-3",
        "modelVersion": "1",
        "format": "Mistral AI",
        "sku": "GlobalStandard",
        "capacity": 1
      },
      {
        "name": "deepseek-v3-2",
        "modelName": "DeepSeek-V3.2",
        "modelVersion": "1",
        "format": "DeepSeek",
        "sku": "GlobalStandard",
        "capacity": 1
      }
    ],
    "cognitiveServicesUserRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'a97b65f3-24c7-4388-baec-2e87135dc908')]",
    "storageBlobDataReaderRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '2a2b9908-6ea1-4ae2-8e65-a410df84e7d1')]",
    "jobNames": [
      {
        "name": "[format('caj-eval-runner-{0}', parameters('env'))]",
        "triggerType": "Manual",
        "cron": ""
      },
      {
        "name": "[format('caj-eval-reconciler-{0}', parameters('env'))]",
        "triggerType": "Schedule",
        "cron": "*/30 * * * *"
      },
      {
        "name": "[format('caj-eval-scheduler-{0}', parameters('env'))]",
        "triggerType": "Schedule",
        "cron": "[parameters('schedulerCron')]"
      },
      {
        "name": "[format('caj-eval-audit-projection-{0}', parameters('env'))]",
        "triggerType": "Schedule",
        "cron": "0 3 * * *"
      }
    ],
    "storageBlobDataContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
    "keyVaultSecretsUserRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "cosmosBuiltinDataContributorId": "[guid(resourceId('Microsoft.DocumentDB/databaseAccounts', format('cosmos-ama-eval-{0}', variables('nameSuffix'))), 'cosmos-data-contributor')]",
    "containerAppsJobsOperatorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b9a307c4-5aa3-4b52-ba60-2b17c136cd7b')]"
  },
  "resources": [
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2024-11-15",
      "name": "[format('cosmos-ama-eval-{0}', variables('nameSuffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "databaseAccountOfferType": "Standard",
        "locations": [
          {
            "locationName": "[parameters('location')]",
            "failoverPriority": 0,
            "isZoneRedundant": false
          }
        ],
        "consistencyPolicy": {
          "defaultConsistencyLevel": "Session"
        },
        "capabilities": [
          {
            "name": "EnableServerless"
          }
        ],
        "publicNetworkAccess": "[variables('dataPlanePublicNetworkAccess')]",
        "minimalTlsVersion": "Tls12",
        "disableLocalAuth": true,
        "backupPolicy": {
          "type": "Periodic",
          "periodicModeProperties": {
            "backupIntervalInMinutes": 240,
            "backupRetentionIntervalInHours": 720,
            "backupStorageRedundancy": "Zone"
          }
        }
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2024-11-15",
      "name": "[format('{0}/{1}', format('cosmos-ama-eval-{0}', variables('nameSuffix')), 'ama-eval')]",
      "properties": {
        "resource": {
          "id": "ama-eval"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('cosmos-ama-eval-{0}', variables('nameSuffix')))]"
      ]
    },
    {
      "copy": {
        "name": "cosmosContainers",
        "count": "[length(variables('containers'))]"
      },
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2024-11-15",
      "name": "[format('{0}/{1}/{2}', format('cosmos-ama-eval-{0}', variables('nameSuffix')), 'ama-eval', variables('containers')[copyIndex()].name)]",
      "properties": {
        "resource": {
          "id": "[variables('containers')[copyIndex()].name]",
          "partitionKey": {
            "paths": [
              "[variables('containers')[copyIndex()].partitionKey]"
            ],
            "kind": "Hash"
          },
          "indexingPolicy": {
            "indexingMode": "consistent"
          },
          "conflictResolutionPolicy": {
            "mode": "LastWriterWins",
            "conflictResolutionPath": "/_ts"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', format('cosmos-ama-eval-{0}', variables('nameSuffix')), 'ama-eval')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2024-01-01",
