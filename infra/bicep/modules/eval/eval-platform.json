{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "2892306124648038578"
    }
  },
  "parameters": {
    "env": {
      "type": "string",
      "allowedValues": [
        "dev",
        "staging",
        "production"
      ],
      "metadata": {
        "description": "Environment name (dev|staging|production)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "australiaeast",
      "metadata": {
        "description": "Resource location — Australia East per constitution NN-2"
      }
    },
    "jobCpu": {
      "type": "string",
      "defaultValue": "1.0",
      "metadata": {
        "description": "Container Apps Job CPU"
      }
    },
    "jobMemory": {
      "type": "string",
      "defaultValue": "2.0Gi",
      "metadata": {
        "description": "Container Apps Job memory"
      }
    },
    "storageImmutabilityState": {
      "type": "string",
      "defaultValue": "[if(equals(parameters('env'), 'dev'), 'Disabled', 'Unlocked')]",
      "allowedValues": [
        "Disabled",
        "Unlocked",
        "Locked"
      ],
      "metadata": {
        "description": "Storage immutability state — Disabled (dev), Unlocked (staging|production initial)"
      }
    },
    "deployContainerJobs": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy Container Apps Jobs after the eval runner image has been published to the eval Azure Container Registry."
      }
    },
    "deployApi": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy the AMA API container app once the api image has been pushed to the eval Azure Container Registry."
      }
    },
    "evalRunnerImageTag": {
      "type": "string",
      "defaultValue": "[parameters('env')]",
      "metadata": {
        "description": "Container image tag for the eval runner."
      }
    },
    "apiImageTag": {
      "type": "string",
      "defaultValue": "[parameters('env')]",
      "metadata": {
        "description": "Container image tag for the AMA API."
      }
    },
    "entraTenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]",
      "metadata": {
        "description": "Entra ID tenant id used for AMA API JWT validation."
      }
    },
    "entraAudience": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Entra ID audience the AMA API expects on inbound JWTs (defaults to the dev app appId)."
      }
    },
    "schedulerCron": {
      "type": "string",
      "defaultValue": "0 18 * * 0",
      "metadata": {
        "description": "Scheduler cron — weekly baseline (overnight Sun 18:00 UTC default)"
      }
    },
    "keyVaultNameSalt": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 2,
      "metadata": {
        "description": "Optional salt appended to the Key Vault name to avoid collisions with prior soft-deleted purge-protected vaults."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "feature": "030-llm-eval-framework",
        "workload": "ama-eval",
        "env": "[parameters('env')]",
        "managed-by": "bicep"
      },
      "metadata": {
        "description": "Tags applied to every resource"
      }
    }
  },
  "variables": {
    "resourceTags": "[union(parameters('tags'), if(equals(parameters('env'), 'dev'), createObject('SecurityControl', 'Ignore'), createObject()))]",
    "nameSuffix": "[format('{0}-{1}', parameters('env'), uniqueString(resourceGroup().id))]",
    "shortUniqueSuffix": "[take(uniqueString(resourceGroup().id), 6)]",
    "storageEnvSegment": "[if(equals(parameters('env'), 'production'), 'prod', parameters('env'))]",
    "storageAccountName": "[take(format('stamaeval{0}{1}', variables('storageEnvSegment'), uniqueString(resourceGroup().id)), 24)]",
    "keyVaultName": "[format('kv-amaeval-{0}-{1}{2}', variables('storageEnvSegment'), variables('shortUniqueSuffix'), parameters('keyVaultNameSalt'))]",
    "logAnalyticsWorkspaceName": "[take(format('log-ama-eval-{0}', variables('nameSuffix')), 63)]",
    "containerRegistryName": "[format('acramaeval{0}{1}', variables('storageEnvSegment'), variables('shortUniqueSuffix'))]",
    "evalRunnerImageRepository": "eval-runner",
    "apiImageRepository": "ama/api",
    "allowPublicEvalDataPlane": "[equals(parameters('env'), 'dev')]",
    "dataPlanePublicNetworkAccess": "[if(variables('allowPublicEvalDataPlane'), 'Enabled', 'Disabled')]",
    "dataPlaneNetworkDefaultAction": "[if(variables('allowPublicEvalDataPlane'), 'Allow', 'Deny')]",
    "acrPullRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
    "containers": [
      {
        "name": "eval_datasets",
        "partitionKey": "/datasetId"
      },
      {
        "name": "eval_runs",
        "partitionKey": "/runId"
      },
      {
        "name": "eval_metric_definitions",
        "partitionKey": "/metricId"
      },
      {
        "name": "eval_audit",
        "partitionKey": "/runId"
      },
      {
        "name": "simulation",
        "partitionKey": "/scenario_id"
      },
      {
        "name": "kpi_ladder",
        "partitionKey": "/kpi_id"
      },
      {
        "name": "kpi_signals",
        "partitionKey": "/scenario_id"
      },
      {
        "name": "delta_scorecards",
        "partitionKey": "/scenario_id"
      },
      {
        "name": "causal_chains",
        "partitionKey": "/capability_id"
      },
      {
        "name": "benchmark_register",
        "partitionKey": "/kpi_id"
      },
      {
        "name": "evidence_audit",
        "partitionKey": "/audit_id"
      },
      {
        "name": "evidence_audit_dlq",
        "partitionKey": "/audit_id"
      }
