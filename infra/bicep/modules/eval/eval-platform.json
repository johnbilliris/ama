      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": true,
        "enablePurgeProtection": "[if(equals(parameters('env'), 'dev'), null(), true())]",
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": "[if(equals(parameters('env'), 'dev'), 7, 90)]",
        "publicNetworkAccess": "[variables('dataPlanePublicNetworkAccess')]",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "[variables('dataPlaneNetworkDefaultAction')]"
        }
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2025-04-01",
      "name": "[variables('containerRegistryName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "anonymousPullEnabled": false,
        "publicNetworkAccess": "Enabled",
        "networkRuleBypassOptions": "AzureServices",
        "policies": {
