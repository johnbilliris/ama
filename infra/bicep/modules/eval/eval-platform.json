      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "sku": {
        "name": "Standard_ZRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "supportsHttpsTrafficOnly": true,
        "publicNetworkAccess": "[variables('dataPlanePublicNetworkAccess')]",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "[variables('dataPlaneNetworkDefaultAction')]"
        },
        "encryption": {
          "services": {
            "blob": {
              "enabled": true,
              "keyType": "Account"
            },
            "file": {
              "enabled": true,
              "keyType": "Account"
            }
          },
          "keySource": "Microsoft.Storage",
          "requireInfrastructureEncryption": true
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "properties": {
        "isVersioningEnabled": true,
        "changeFeed": {
          "enabled": true,
          "retentionInDays": 2555
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "copy": {
        "name": "blobContainers",
        "count": "[length(variables('blobContainerNames'))]"
      },
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('blobContainerNames')[copyIndex()])]",
      "properties": {
        "publicAccess": "None",
        "immutableStorageWithVersioning": {
          "enabled": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "copy": {
        "name": "blobImmutabilityPolicies",
        "count": "[length(variables('blobContainerNames'))]"
      },
      "condition": "[not(equals(parameters('storageImmutabilityState'), 'Disabled'))]",
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers/immutabilityPolicies",
      "apiVersion": "2024-01-01",
      "name": "[format('{0}/{1}/{2}/{3}', variables('storageAccountName'), 'default', variables('blobContainerNames')[copyIndex()], 'default')]",
      "properties": {
        "immutabilityPeriodSinceCreationInDays": 2555,
        "allowProtectedAppendWrites": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', variables('blobContainerNames')[copyIndex()])]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-04-01-preview",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
