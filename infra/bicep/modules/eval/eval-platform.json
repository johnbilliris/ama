      "name": "[format('{0}/{1}', format('cosmos-ama-eval-{0}', variables('nameSuffix')), guid(resourceId('Microsoft.DocumentDB/databaseAccounts', format('cosmos-ama-eval-{0}', variables('nameSuffix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-caj-eval-runner-{0}', variables('nameSuffix'))), 'cosmos-data-contributor'))]",
      "properties": {
        "roleDefinitionId": "[format('{0}/sqlRoleDefinitions/00000000-0000-0000-0000-000000000002', resourceId('Microsoft.DocumentDB/databaseAccounts', format('cosmos-ama-eval-{0}', variables('nameSuffix'))))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-caj-eval-runner-{0}', variables('nameSuffix'))), '2023-01-31').principalId]",
        "scope": "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('cosmos-ama-eval-{0}', variables('nameSuffix')))]"
