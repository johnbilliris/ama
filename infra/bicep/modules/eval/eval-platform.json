          "defaultAction": "[variables('dataPlaneNetworkDefaultAction')]",
          "virtualNetworkRules": [],
          "ipRules": []
        },
        "disableLocalAuth": true
      }
    },
    {
      "copy": {
        "name": "foundryDeployments",
        "count": "[length(variables('foundryModelDeployments'))]",
        "mode": "serial",
        "batchSize": 1
      },
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
