    "redis": {
      "type": "Microsoft.Cache/redis",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}{1}-{2}', variables('abbrs').cacheRedis, parameters('environmentName'), take(variables('uniqueSuffix'), 6))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
