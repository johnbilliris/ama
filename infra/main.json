      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', format('{0}{1}{2}', variables('abbrs').storageStorageAccounts, take(replace(parameters('environmentName'), '-', ''), 14), take(variables('uniqueSuffix'), 6))), parameters('principalId'), 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
