                {
                  "name": "OTEL_SERVICE_NAME",
                  "value": "agents"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3
          }
        }
      },
      "dependsOn": [
        "apiContainerApp",
        "containerRegistry",
        "cosmos",
        "managedEnvironment",
        "monitoring",
