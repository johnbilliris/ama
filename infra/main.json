    "apiContainerApp": {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[take(format('{0}api-{1}', variables('abbrs').appContainerApps, parameters('environmentName')), 32)]",
      "location": "[parameters('location')]",
      "tags": "[union(variables('tags'), createObject('azd-service-name', 'api'))]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', take(format('{0}{1}', variables('abbrs').appManagedEnvironments, parameters('environmentName')), 60))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8000
          },
          "registries": [
            {
              "server": "[reference('containerRegistry').loginServer]",
              "username": "[listCredentials('containerRegistry', '2023-07-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "secrets": [
            {
              "name": "acr-password",
              "value": "[listCredentials('containerRegistry', '2023-07-01').passwords[0].value]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[parameters('apiImage')]",
              "resources": {
                "cpu": "[json('1.0')]",
                "memory": "2Gi"
              },
              "env": [
                {
                  "name": "COSMOS_ENDPOINT",
                  "value": "[reference('cosmos').documentEndpoint]"
                },
                {
                  "name": "COSMOS_DATABASE",
                  "value": "disaster-hub"
                },
                {
                  "name": "STORAGE_ACCOUNT_NAME",
                  "value": "[format('{0}{1}{2}', variables('abbrs').storageStorageAccounts, take(replace(parameters('environmentName'), '-', ''), 14), take(variables('uniqueSuffix'), 6))]"
                },
                {
                  "name": "REDIS_HOST",
                  "value": "[reference('redis').hostName]"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference('monitoring').outputs.appInsightsConnectionString.value]"
                },
                {
                  "name": "AZURE_OPENAI_ENDPOINT",
                  "value": "[reference('openAi').endpoint]"
                },
                {
                  "name": "OTEL_SERVICE_NAME",
                  "value": "api"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 4
          }
        }
      },
      "dependsOn": [
        "containerRegistry",
        "cosmos",
        "managedEnvironment",
        "monitoring",
        "openAi",
        "redis",
        "storage"
      ]
    },
    "agentsContainerApp": {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[take(format('{0}agents-{1}', variables('abbrs').appContainerApps, parameters('environmentName')), 32)]",
