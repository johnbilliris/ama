      "name": "[format('{0}/{1}/{2}', take(format('{0}{1}-{2}', variables('abbrs').documentDBDatabaseAccounts, parameters('environmentName'), take(variables('uniqueSuffix'), 6)), 44), 'disaster-hub', 'signals')]",
      "properties": {
        "resource": {
          "id": "signals",
          "partitionKey": {
            "paths": [
              "/scope",
              "/jurisdictionId",
              "/dataSourceId"
            ],
            "kind": "MultiHash",
            "version": 2
          },
          "indexingPolicy": {
            "indexingMode": "consistent",
            "compositeIndexes": [
              [
                {
                  "path": "/jurisdictionId",
                  "order": "ascending"
