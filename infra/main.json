      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', format('{0}{1}{2}', variables('abbrs').storageStorageAccounts, take(replace(parameters('environmentName'), '-', ''), 14), take(variables('uniqueSuffix'), 6))), resourceId('Microsoft.App/containerApps', take(format('{0}ingest-{1}', variables('abbrs').appContainerApps, parameters('environmentName')), 32)), 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
      "properties": {
