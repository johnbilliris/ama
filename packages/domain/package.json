{
  "name": "@ama/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript domain types for spec-035 (AppRole, PersonaId, AuditOutcome, OfflineQueueTier).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "6.0.3"
  }
}
