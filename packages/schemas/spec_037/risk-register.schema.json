{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example.gov.au/schemas/spec_037/risk-register.schema.json",
  "title": "RiskRegisterArtefact",
  "description": "Artefact 1 — Systematic Risk Register. Honours FR-010..FR-014.",
  "type": "object",
  "required": ["artefact_id", "schema_version", "publication_id", "published_at_utc", "published_by", "metadata", "rows"],
  "properties": {
    "artefact_id": { "const": "risk_register" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "publication_id": { "type": "string", "format": "uuid" },
    "published_at_utc": { "type": "string", "format": "date-time" },
    "published_by": { "type": "string" },
    "metadata": { "$ref": "publication-gate-metadata.schema.json" },
    "superseded_surfaces": { "type": "array", "items": { "type": "string" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/RiskRow" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BackCitation": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["spec", "adr", "governance_hub", "telemetry_sink", "agent_md"] },
        "ref": { "type": "string", "minLength": 1 },
        "section": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "required": ["tag", "source", "evidence_status"],
      "properties": {
        "tag": { "type": "string", "enum": ["automated", "manual"] },
        "source": { "type": "string" },
        "owner": { "type": "string" },
        "review_cadence": { "type": "string", "enum": ["quarterly", "monthly", "post-incident"] },
        "automation_target": { "type": "string" },
        "evidence_status": { "type": "string", "enum": ["Validated", "Deferred", "Unresolved"] }
      },
      "allOf": [
        {
          "if": { "properties": { "tag": { "const": "manual" } }, "required": ["tag"] },
          "then": { "required": ["owner", "review_cadence", "automation_target"] }
        }
      ],
      "additionalProperties": false
    },
    "RiskRow": {
      "type": "object",
      "required": [
        "id", "title", "category", "description",
        "likelihood", "consequence", "inherent_score",
        "treatment", "owner",
        "residual_likelihood", "residual_consequence", "residual_score",
        "next_review_date", "back_citations", "provenance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^RISK-[A-Z0-9]+-\\d{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": ["Platform", "AI", "Operational", "Jurisdictional", "Data", "Supply-chain"]
        },
        "description": { "type": "string", "minLength": 1 },
        "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
        "consequence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "inherent_score": { "type": "integer", "minimum": 1, "maximum": 25 },
        "treatment": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "residual_likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
        "residual_consequence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "residual_score": { "type": "integer", "minimum": 1, "maximum": 25 },
        "next_review_date": { "type": "string", "format": "date" },
        "back_citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/BackCitation" }
        },
        "provenance": { "$ref": "#/$defs/Provenance" }
      },
      "additionalProperties": false
    }
  }
}
